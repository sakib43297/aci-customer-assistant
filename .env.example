# ==============================================================================
# ACI Customer Assistant - Environment Variables Guide
# ==============================================================================

# 1. GEMINI API KEY (OPTIONAL FOR AI CHAT & VOICE SEARCH)
# Stored strictly on the backend (server.ts) and NEVER exposed to the browser client.
# Supply the key only on the server or through the in-app administrator guide.
GEMINI_API_KEY=""
TRUSTED_PROXY_CIDRS="replace-with-trusted-tunnel-proxy-cidrs"

# 2. HOST APPLICATION URL
# Used for local self-referential links and API routing.
APP_URL="http://localhost:2312"

# 3. LOCAL DATABASE
# This project's SQLite file lives beside this package.json by default.
DATABASE_PATH="./aci-platform.sqlite"

# 4. ADMIN CREDENTIALS
# The seeded admin account uses these values. Change them before deployment.
ADMIN_ID="replace-with-your-admin-id"
ADMIN_PASSWORD=""

# JWT signing and validation (required; use a unique random value of 32+ characters)
JWT_SECRET="replace-with-a-unique-32-character-secret"
JWT_ISSUER="aci-customer-assistant"
JWT_AUDIENCE="aci-customer-assistant-web"
PORT="8080"
HOST="0.0.0.0"
