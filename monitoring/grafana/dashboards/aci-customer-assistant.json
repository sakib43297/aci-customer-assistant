{
  "title": "ACI Customer Assistant",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "panels": [
    { "type": "timeseries", "title": "HTTP requests", "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 }, "targets": [{ "expr": "sum by (status) (rate(aci_http_requests_total[5m]))", "legendFormat": "{{status}}" }] },
    { "type": "stat", "title": "Process uptime", "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 }, "targets": [{ "expr": "process_uptime_seconds" }] }
  ]
}
